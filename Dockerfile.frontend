# syntax=docker/dockerfile:1
# Multi-stage build: install deps, build the Vite bundle, serve statically with nginx.

# ---------- build stage ----------
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN npm run build

# ---------- runtime stage ----------
FROM nginx:alpine AS runtime

# nginx serves the built SPA from /usr/share/nginx/html.
COPY --from=build /app/dist /usr/share/nginx/html

# Single-page-app fallback: unknown paths should serve index.html so client-side
# routing keeps working (e.g. /api/v1/jobs is handled by the backend proxy, but
# /jobs, /applications, etc. are frontend routes).
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]