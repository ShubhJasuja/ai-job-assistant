# syntax=docker/dockerfile:1
# Multi-stage build: compile with Maven, then run on a minimal JRE image.

# ---------- build stage ----------
FROM eclipse-temurin:21-jdk-alpine AS build

WORKDIR /app

# Copy pom.xml first to leverage Docker layer caching for dependencies.
COPY pom.xml .
COPY mvnw .
COPY .mvn .mvn

# Download dependencies in a separate layer (requires network at build time).
RUN ./mvnw -B -q dependency:go-offline -DskipTests

# Copy source and compile.
COPY src src
RUN ./mvnw -B -DskipTests package -Dmaven.test.skip=true

# ---------- runtime stage ----------
FROM eclipse-temurin:21-jre-alpine AS runtime

WORKDIR /app

# Non-root user: never run the container as root.
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=build /app/target/*.jar /app/app.jar

RUN mkdir -p /app/uploads && chown -R appuser:appgroup /app
USER appuser

EXPOSE 8080

# Spring Boot reads config from env vars (SPRING_PROFILES_ACTIVE, DB_*, JWT_SECRET, ...).
ENTRYPOINT ["java", "-jar", "/app/app.jar"]