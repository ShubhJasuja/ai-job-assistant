# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets here.

# --- Database ---
DB_HOST=localhost
DB_NAME=jobassistant_db
DB_USER=jobadmin
DB_PASSWORD=change-me-db-password
DB_PORT=5433

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380

# --- Backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Security ---
# 64+ char random string, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret

# --- AI provider (optional, defaults to noop) ---
# AI_PROVIDER=noop | openai | anthropic
AI_PROVIDER=noop
# AI_ENABLED=true | false
AI_ENABLED=false
# AI_API_KEY=sk-...

# --- Job sources ---
# Verified public starter boards; override with comma-separated board=company values.
GREENHOUSE_BOARDS=stripe=Stripe,anthropic=Anthropic,datadog=Datadog,cloudflare=Cloudflare,mongodb=MongoDB
# Add only verified Lever sites. None were included in the current starter set.
# LEVER_SITES=company-site-slug=Company Name
# Optional public HTTPS feeds, comma-separated as URL|Company Name.
# RSS_FEEDS=https://jobs.example.com/feed.xml|Company Name
# LinkedIn/Indeed ingestion requires official feeds or API credentials/access.