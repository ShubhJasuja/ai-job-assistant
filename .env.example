# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets here.

# --- Database ---
DB_NAME=jobassistant_db
DB_USER=jobadmin
DB_PASSWORD=change-me-db-password
DB_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Security ---
# 64+ char random string, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret

# --- AI provider (optional, defaults to noop) ---
# AI_PROVIDER=noop | openai | anthropic
AI_PROVIDER=noop
# AI_ENABLED=true | false
AI_ENABLED=false
# AI_API_KEY=sk-...